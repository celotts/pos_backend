# --- Puertos de Aplicación (Host) ---
API_GATEWAY_PORT=8090
CONFIG_PORT=7777
AUTH_PORT=8081
DISCOVERY_PORT=8761
PRODUCT_PORT=9090
SUPPLIER_PORT=9091
PURCHASE_PORT=9094
TAX_PORT=9093

ON_PROFILE=docker
OPTIONAL_CONFIG_SERVER="optional:configserver:http://config-service:7777"
# --- Discovery & Config Server (Docker Network) ---
EUREKA_HOST=discovery-service
CONFIG_HOST=config-service
CONFIG_SERVER_ENABLED=false

PATHAPI_DOCS=/v3/api-docs
PATH_SPRING_DOC=/swagger-ui.html
OPTIONAL_CONFIG_SERVICE="optional:configserver:"
DISCOVERY_SERVICE_EUREKA=http://discovery-service:8761/eureka/
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery-service:8761/eureka/
SPRING_CLOUD_CONFIG_URI=http://config-service:7777
SPRING_CLOUD_CONFIG_SERVER_GIT_URI=https://github.com/celotts/config-repo.git
SPRING_DATASOURCE_HIKARI_AUTO_COMMIT=false

# --- Configuración de Base de Datos Global ---
DB_PROTOCOL=postgresql
DB_DRIVER=org.postgresql.Driver
DB_PORT_INTERNAL=5432
IMAGE_DB=postgres:16

CORS_ALLOWED_ORIGIN=*
# --- 1. PRODUCT SERVICE ---
PRODUCT_SERVICE_NAME=product-service
PRODUCT_DB_NAME=product
PRODUCT_DB_USERNAME=product
PRODUCT_DB_PASSWORD=product123
PRODUCT_DB_HOST=db_product
PRODUCT_DB_PORT_HOST=5433

# --- 2. SUPPLIER SERVICE ---
SUPPLIER_SERVICE_NAME=supplier-service
SUPPLIER_DB_NAME=supplier
SUPPLIER_DB_USERNAME=supplier
SUPPLIER_DB_PASSWORD=supplier123
SUPPLIER_DB_HOST=db_supplier
SUPPLIER_DB_PORT_HOST=5434

# --- 3. PURCHASE SERVICE ---
PURCHASE_SERVICE_NAME=purchase-service
PURCHASE_DB_NAME=purchase
PURCHASE_DB_USERNAME=purchase
PURCHASE_DB_PASSWORD=purchase123
PURCHASE_DB_HOST=db_purchase
PURCHASE_DB_PORT_HOST=5435

# --- 4. TAX SERVICE ---
TAX_SERVICE_NAME=tax-service
TAX_DB_NAME=tax
TAX_DB_USERNAME=tax
TAX_DB_PASSWORD=tax123
TAX_DB_HOST=db_tax
TAX_DB_PORT_HOST=5436

# --- Tiempos y Healthchecks (Docker) ---
RETRIES5=5
RETRIES10=10
ILDETIMEOUT=600000
MAXLIFETIME=1800000

INTERVAL20S=20s

VAR_TRUE=true
VAR_FALSE=false
TIMEOUT10S=10s
START_PERIOD30S:30s
START_PERIOD60S=60s
INTERVAL10S=10s
TIMEOUT5S=5s

SPRING_DATASOURCE_URL=jdbc:postgresql://${SUPPLIER_DB_HOST}:${DB_PORT_INTERNAL}/${SUPPLIER_DB_NAME}

SALES_SERVICE_NAME=sales-service

