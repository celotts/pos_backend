ONPROFILE=local
JAVA_PERF_OPTS=-Xmx512m -XX:+TieredCompilation -XX:TieredStopAtLevel=1

# --- Credenciales de Infraestructura (CRÍTICO) ---
DOCKER_USERNAME=celotts
